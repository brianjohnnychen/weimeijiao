  shoes: '<path d="M3 15c0-3 1-6 3-6l3 3h4c3 0 7 1 8 4v2H3z"/>',
  backpack: '<path d="M8 6V5a4 4 0 0 1 8 0v1M5 9a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v11H5zM9 13h6"/>',
