  teeth: '<path d="M7 4c-2 0-3 2-3 4 0 4 2 5 2 9 0 2 1 3 2 3s1.5-3 2-5h4c.5 2 1 5 2 5s2-1 2-3c0-4 2-5 2-9 0-2-1-4-3-4-2 0-3 1-5 1S9 4 7 4z"/>',
  dress: '<path d="M9 3l3 2 3-2 4 3-2 3-2-1v12H9V8L7 9 5 6z"/>',
