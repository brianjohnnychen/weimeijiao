---
// Honest effort estimate for a method (little-time guide): time per use, setup, and skill.
interface Props { time: string; label?: string }
const { time, label } = Astro.props;
---
<span class="effort"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>{label && <span class="visually-hidden">{label} </span>}{time}</span>
