---
import MdxPage from '../../components/MdxPage.astro';
import { localeStaticPaths, type Locale } from '../../i18n/locales';

export function getStaticPaths() {
  return localeStaticPaths();
}
const { locale } = Astro.props as { locale: Locale };
---
<MdxPage locale={locale} slug="little-time" tocLevels={[2, 3]} />
