---
import { render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { mdxComponents } from '../../../components/mdx';
import { LOCALES, paramFromLocale, type Locale } from '../../../i18n/locales';
import { t } from '../../../i18n/ui';
import { PHASES, type Phase } from '../../../lib/site';
import { getLearning, getPage, assertParity } from '../../../lib/content';
import { href, paths } from '../../../lib/routes';
import { setupCites, headingsIn } from '../../../lib/page';
import { pageSources } from '../../../lib/cites';
import { entryText } from '../../../lib/sources';

export function getStaticPaths() {
  return LOCALES.flatMap((locale) => PHASES.map((phase) => ({ params: { lang: paramFromLocale(locale), phase }, props: { locale, phase } })));
}
const { locale, phase } = Astro.props as { locale: Locale; phase: Phase };
await assertParity();
const ui = t(locale);
const hub = await getPage(locale, 'learning');
const entry = await getLearning(locale, phase);
setupCites(Astro.locals, locale);
const { Content } = await render(entry);
const toc = headingsIn(entry.body);
const sources = pageSources([entryText(entry)]);
const i = PHASES.indexOf(phase);
const prev = i > 0 ? PHASES[i - 1] : undefined;
const next = i < PHASES.length - 1 ? PHASES[i + 1] : undefined;
const title = `${hub.data.title}: ${ui.phaseName[phase]} (${ui.phaseAge[phase]})`;
---
<Article
  locale={locale}
  title={title}
  description={entry.data.description}
  eyebrow={hub.data.title}
  lede={entry.data.lede}
  image={entry.data.image}
  trail={[{ label: hub.data.title, path: paths.learning() }, { label: `${ui.phaseName[phase]} (${ui.phaseAge[phase]})` }]}
  start={entry.data.start}
  toc={toc}
  sources={sources}
>
  <Content components={mdxComponents} />
  <section class="related" id="printable" aria-labelledby="printable-heading">
    <h2 id="printable-heading">{ui.learning.printable}</h2>
    <p><a class="btn" href={href(locale, paths.printable(`learning-${phase}` as const))}>{ui.learning.printableCta}</a></p>
  </section>
  <nav class="pager" aria-label={hub.data.title}>
    {prev ? <a class="prev" href={href(locale, paths.learningPhase(prev))}><small>{ui.phase.prev}</small>{ui.phaseName[prev]} ({ui.phaseAge[prev]})</a> : <span />}
    {next ? <a class="next" href={href(locale, paths.learningPhase(next))}><small>{ui.phase.next}</small>{ui.phaseName[next]} ({ui.phaseAge[next]})</a> : <span />}
  </nav>
  <Fragment slot="aside">
    <nav class="aside-box" aria-labelledby="discipline-link-heading">
      <h2 id="discipline-link-heading">{ui.nav.byAge}</h2>
      <ul><li><a href={href(locale, paths.phase(phase))}>{ui.phaseName[phase]} ({ui.phaseAge[phase]})</a></li></ul>
    </nav>
  </Fragment>
</Article>
